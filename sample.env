# ____REMOVE THIS LINE AFTER RENAMING sample.env to .env ____

# PUT YOUR SESSION ID BELOW (Optional when pairing from /)
SESSION_ID=

# PUT YOUR REMOVE BACKGROUND KEY (Optional)
REMOVEBG_KEY=

PORT=5000

# Set a long, unique secret before exposing the pairing page
PAIRING_PAGE_PASSWORD=

# Optional terminal pairing; leave empty to use the web pairing page
PAIRING_NUMBER=

# AI provider proxy keys (optional; required by the corresponding AI commands)
AI_PROXY_API_KEY=
CHATBOT_API_KEY=

# Other optional API keys
GIPHY_API_KEY=
NEOXR_KEY=
ZENZAPIS_KEY=

# Use One Of Following:
# Database Configuration (Optional but recommended)
# Leave empty to use JSON file storage

# MongoDB (Optional)
MONGO_URL=

# PostgreSQL (Optional)
POSTGRES_URL=

# MySQL (Optional)
MYSQL_URL=

# SQLite Path (Optional)
# Example: DB_URL=./data/baileys.db
DB_URL=

PREFIXES=.,!,/

PACKNAME=MEGA-MD

BOT_NAME=MEGA-MD-PRO

OWNER_NUMBER=923000000000

COMMAND_MODE=private

BOT_OWNER=GlobalTechInfo

TIMEZONE=Asia/Karachi
